#!/usr/bin/env python3
"""
Builds two animated SVGs for the profile README from the GitHub API:

    assets/stats.svg           bounty board (followers, repos, stars, commits, languages, streaks)
    assets/contributions.svg   the "sea chart" (contribution calendar with a ship sailing over it)

Uses only the Python standard library. Run by .github/workflows/update-profile.yml,
which provides GH_USER and GH_TOKEN. No setup needed on your machine.
"""
import html
import json
import os
import sys
import urllib.request
from collections import Counter

USER = os.environ.get("GH_USER", "zerefnochills")
TOKEN = os.environ.get("GH_TOKEN", "")
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "assets")

SERIF = "Georgia, 'Times New Roman', serif"
SANS = "'Segoe UI', 'Trebuchet MS', Verdana, sans-serif"
GOLD = "#F5C542"

# --------------------------------------------------------------------------- #
# Shared drawing helpers (also imported by the static asset builder)
# --------------------------------------------------------------------------- #

# A pirate ship silhouette. Origin (0,0) is the waterline, centre of the hull.
SHIP = """<g>
  <path d="M-84 -6 L84 -6 Q80 22 52 30 L-48 30 Q-76 24 -84 -6 Z" fill="#08111f"/>
  <rect x="38" y="-24" width="44" height="18" rx="2" fill="#08111f"/>
  <path d="M-84 -6 L-114 -24" stroke="#08111f" stroke-width="4" stroke-linecap="round"/>
  <rect x="-3" y="-134" width="6" height="130" fill="#08111f"/>
  <rect x="-54" y="-94" width="5" height="90" fill="#08111f"/>
  <rect x="48" y="-102" width="5" height="98" fill="#08111f"/>
  <path d="M-42 -124 Q0 -112 42 -124 L38 -52 Q0 -42 -38 -52 Z" fill="#17294a" stroke="#08111f" stroke-width="2"/>
  <path d="M-78 -90 Q-52 -82 -26 -90 L-30 -36 Q-52 -30 -74 -36 Z" fill="#17294a" stroke="#08111f" stroke-width="2"/>
  <path d="M24 -98 Q50 -90 76 -98 L72 -44 Q50 -38 28 -44 Z" fill="#17294a" stroke="#08111f" stroke-width="2"/>
  <path d="M0 -134 L-54 -94 M0 -134 L50 -102 M0 -134 L-84 -6 M0 -134 L84 -6" stroke="#08111f" stroke-width="1" opacity=".75"/>
  <ellipse cx="0" cy="-80" rx="15" ry="4" fill="#F5C542"/>
  <path d="M-9 -80 Q-9 -93 0 -93 Q9 -93 9 -80 Z" fill="#F5C542"/>
  <rect x="-9" y="-84" width="18" height="3" fill="#E74C3C"/>
  <path fill="#E74C3C" d="M3 -132 L3 -146 Q20 -140 38 -146 Q30 -138 38 -130 Q20 -136 3 -132 Z">
    <animate attributeName="d" dur="1.3s" repeatCount="indefinite"
      values="M3 -132 L3 -146 Q20 -140 38 -146 Q30 -138 38 -130 Q20 -136 3 -132 Z;
              M3 -132 L3 -146 Q20 -150 38 -143 Q32 -136 38 -131 Q20 -128 3 -132 Z;
              M3 -132 L3 -146 Q20 -140 38 -146 Q30 -138 38 -130 Q20 -136 3 -132 Z"/>
  </path>
  <circle cx="-30" cy="8" r="2.6" fill="#F5C542"><animate attributeName="opacity" values="1;.35;1" dur="2.1s" repeatCount="indefinite"/></circle>
  <circle cx="-8" cy="8" r="2.6" fill="#F5C542"><animate attributeName="opacity" values=".4;1;.4" dur="1.7s" repeatCount="indefinite"/></circle>
  <circle cx="14" cy="8" r="2.6" fill="#F5C542"><animate attributeName="opacity" values="1;.3;1" dur="2.6s" repeatCount="indefinite"/></circle>
  <circle cx="36" cy="8" r="2.6" fill="#F5C542"><animate attributeName="opacity" values=".5;1;.5" dur="1.9s" repeatCount="indefinite"/></circle>
</g>"""


def wave(width, y, bottom, amp, wl, color, dur, direction=1, opacity=1.0, begin=0):
    """A seamless, endlessly scrolling sine wave filled down to `bottom`."""
    n = int((width + 2 * wl) / (wl / 2)) + 2
    d = f"M {-wl} {y} q {wl / 4:.1f} {-2 * amp:.1f} {wl / 2:.1f} 0" + f" t {wl / 2:.1f} 0" * n
    d += f" V {bottom} H {-wl} Z"
    return (
        f'<g><animateTransform attributeName="transform" type="translate" from="0 0" '
        f'to="{direction * wl} 0" dur="{dur}s" begin="{begin}s" repeatCount="indefinite"/>'
        f'<path d="{d}" fill="{color}" opacity="{opacity}"/></g>'
    )


# --------------------------------------------------------------------------- #
# Fetching
# --------------------------------------------------------------------------- #

def api(url, payload=None):
    req = urllib.request.Request(url, data=payload)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("User-Agent", "profile-readme-stats")
    if TOKEN:
        req.add_header("Authorization", "Bearer " + TOKEN)
    if payload:
        req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)


def fetch():
    d = {"ok": False, "followers": 0, "repos": 0, "stars": 0, "commits": 0, "prs": 0,
         "issues": 0, "langs": [], "weeks": [], "total": 0}
    try:
        u = api(f"https://api.github.com/users/{USER}")
        d["followers"] = u.get("followers", 0)
        d["repos"] = u.get("public_repos", 0)
        d["ok"] = True
    except Exception as exc:  # noqa: BLE001
        print("could not read user profile:", exc)

    try:
        repos, page = [], 1
        while page <= 5:
            batch = api(f"https://api.github.com/users/{USER}/repos?per_page=100&type=owner&page={page}")
            repos += batch
            if len(batch) < 100:
                break
            page += 1
        d["stars"] = sum(r.get("stargazers_count", 0) for r in repos)
        counts = Counter(r["language"] for r in repos if r.get("language") and not r.get("fork"))
        total = sum(counts.values())
        d["langs"] = [(k, v / total) for k, v in counts.most_common(5)] if total else []
    except Exception as exc:  # noqa: BLE001
        print("could not read repos:", exc)

    try:
        query = (
            "query($login:String!){user(login:$login){contributionsCollection{"
            "totalCommitContributions totalPullRequestContributions totalIssueContributions "
            "contributionCalendar{totalContributions weeks{contributionDays{date weekday contributionCount}}}"
            "}}}"
        )
        res = api("https://api.github.com/graphql",
                  json.dumps({"query": query, "variables": {"login": USER}}).encode())
        cc = res["data"]["user"]["contributionsCollection"]
        d["commits"] = cc["totalCommitContributions"]
        d["prs"] = cc["totalPullRequestContributions"]
        d["issues"] = cc["totalIssueContributions"]
        cal = cc["contributionCalendar"]
        d["total"] = cal["totalContributions"]
        d["weeks"] = [
            [(x["weekday"], x["contributionCount"], x["date"]) for x in w["contributionDays"]]
            for w in cal["weeks"]
        ]
    except Exception as exc:  # noqa: BLE001
        print("could not read contribution calendar:", exc)
    return d


# --------------------------------------------------------------------------- #
# Rendering
# --------------------------------------------------------------------------- #

LANG_COLORS = {
    "JavaScript": "#f1e05a", "TypeScript": "#3178c6", "Python": "#3572A5", "Java": "#b07219",
    "HTML": "#e34c26", "CSS": "#8a63d2", "PHP": "#8892BF", "C": "#7d7d7d", "C++": "#f34b7d",
    "C#": "#26a269", "Go": "#00ADD8", "Rust": "#dea584", "Shell": "#89e051", "Dart": "#00B4AB",
    "Kotlin": "#A97BFF", "Swift": "#F05138", "Ruby": "#cc342d", "Vue": "#41b883",
    "SCSS": "#c6538c", "Jupyter Notebook": "#DA5B0B", "Lua": "#6c7bff",
}


def fmt(n):
    n = int(n)
    return f"{n / 1000:.1f}k".replace(".0k", "k") if n >= 1000 else str(n)


def streaks(days):
    longest = cur = 0
    for c in days:
        cur = cur + 1 if c > 0 else 0
        longest = max(longest, cur)
    run = 0
    for i, c in enumerate(reversed(days)):
        if c > 0:
            run += 1
        elif i == 0:
            continue  # today may simply not have a contribution yet
        else:
            break
    return run, longest


STATS_CSS = """<style>
.pop{animation:pop .8s cubic-bezier(.2,.8,.2,1) both}
@keyframes pop{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.pulse{animation:pulse 2.6s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.55}50%{opacity:1}}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style>"""


def card(x, y, w, h, label, value, sub, color, delay):
    return f"""<g transform="translate({x} {y})"><g class="pop" style="animation-delay:{delay:.2f}s">
  <rect width="{w}" height="{h}" rx="14" fill="url(#card)" stroke="{color}" stroke-opacity=".45"/>
  <rect x="14" width="{w - 28}" height="3" rx="1.5" fill="{color}" opacity=".85"/>
  <rect x="14" width="36" height="3" rx="1.5" fill="#fff" opacity=".85">
    <animate attributeName="x" values="14;{w - 50};14" dur="4.5s" repeatCount="indefinite"/></rect>
  <text x="18" y="30" font-family="{SANS}" font-size="12" font-weight="700" letter-spacing="1" fill="{color}">{html.escape(label)}</text>
  <text x="18" y="68" font-family="{SERIF}" font-size="36" font-weight="700" fill="#FFFFFF">{html.escape(str(value))}</text>
  <text x="18" y="86" font-family="{SANS}" font-size="11" fill="#8fa3bd">{html.escape(sub)}</text>
</g></g>"""


def lang_panel(x, y, w, h, langs):
    s = f"""<g transform="translate({x} {y})"><g class="pop" style="animation-delay:.55s">
  <rect width="{w}" height="{h}" rx="14" fill="url(#card)" stroke="{GOLD}" stroke-opacity=".4"/>
  <text x="20" y="30" font-family="{SANS}" font-size="12" font-weight="700" letter-spacing="1" fill="{GOLD}">Devil Fruit powers</text>"""
    if not langs:
        s += f'<text x="{w / 2}" y="{h / 2 + 10}" text-anchor="middle" font-family="{SERIF}" font-style="italic" font-size="14" fill="#8fa3bd">No fruit eaten yet…</text>'
    bar_w = 128
    top_pct = max((p for _, p in langs), default=1)
    for i, (name, pct) in enumerate(langs):
        ry = 62 + i * 28
        color = LANG_COLORS.get(name, GOLD)
        fw = max(5, bar_w * pct / top_pct)
        s += f"""
  <text x="20" y="{ry}" font-family="{SANS}" font-size="12.5" fill="#FFFFFF">{html.escape(name)}</text>
  <rect x="124" y="{ry - 9}" width="{bar_w}" height="9" rx="4.5" fill="#1a2e4a"/>
  <rect x="124" y="{ry - 9}" width="0" height="9" rx="4.5" fill="{color}">
    <animate attributeName="width" from="0" to="{fw:.1f}" dur="1.3s" begin="{0.6 + i * 0.15:.2f}s" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines=".2 .8 .2 1"/></rect>
  <text x="{w - 18}" y="{ry}" text-anchor="end" font-family="{SANS}" font-size="11" fill="#8fa3bd">{pct * 100:.0f}%</text>"""
    return s + "</g></g>"


def streak_panels(y, run, longest, total):
    w, h, gap = 278, 132, 13
    circ = 238.76
    off = circ * (1 - min(run / 30, 1))
    msg = ["days sailing without rest", ""] if run else ["Hoist the sails and", "make a commit today!"]
    a = f"""<g transform="translate(0 {y})"><g class="pop" style="animation-delay:.8s">
  <rect width="{w}" height="{h}" rx="14" fill="url(#card)" stroke="#E74C3C" stroke-opacity=".5"/>
  <circle cx="68" cy="68" r="38" fill="none" stroke="#1a2e4a" stroke-width="7"/>
  <circle cx="68" cy="68" r="38" fill="none" stroke="#E74C3C" stroke-width="7" stroke-linecap="round"
    stroke-dasharray="{circ}" stroke-dashoffset="{circ}" transform="rotate(-90 68 68)">
    <animate attributeName="stroke-dashoffset" from="{circ}" to="{off:.1f}" dur="1.6s" begin=".9s" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines=".2 .8 .2 1"/></circle>
  <text x="68" y="78" text-anchor="middle" font-family="{SERIF}" font-size="30" font-weight="700" fill="#FFFFFF">{run}</text>
  <text x="124" y="46" font-family="{SANS}" font-size="12" font-weight="700" letter-spacing="1" fill="#E74C3C">Current streak</text>
  <text x="124" y="70" font-family="{SANS}" font-size="12" fill="#8fa3bd">{msg[0]}</text>
  <text x="124" y="86" font-family="{SANS}" font-size="12" fill="#8fa3bd">{msg[1]}</text>
  <text x="124" y="112" font-size="18" class="pulse">🔥</text>
</g></g>"""
    b = f"""<g transform="translate({w + gap} {y})"><g class="pop" style="animation-delay:.95s">
  <rect width="{w}" height="{h}" rx="14" fill="url(#card)" stroke="{GOLD}" stroke-opacity=".5"/>
  <text x="24" y="34" font-family="{SANS}" font-size="12" font-weight="700" letter-spacing="1" fill="{GOLD}">Longest streak</text>
  <text x="24" y="86" font-family="{SERIF}" font-size="50" font-weight="700" fill="#FFFFFF">{longest}</text>
  <text x="24" y="112" font-family="{SANS}" font-size="12" fill="#8fa3bd">days in a row, over the last year</text>
</g></g>"""
    c = f"""<g transform="translate({2 * (w + gap)} {y})"><g class="pop" style="animation-delay:1.1s">
  <rect width="{w}" height="{h}" rx="14" fill="url(#card)" stroke="#00C2FF" stroke-opacity=".5"/>
  <text x="24" y="34" font-family="{SANS}" font-size="12" font-weight="700" letter-spacing="1" fill="#00C2FF">Voyage log</text>
  <text x="24" y="86" font-family="{SERIF}" font-size="50" font-weight="700" fill="#FFFFFF">{fmt(total)}</text>
  <text x="24" y="112" font-family="{SANS}" font-size="12" fill="#8fa3bd">contributions in the last 12 months</text>
</g></g>"""
    return a + b + c


def render_stats(d):
    W, H = 860, 360
    cards = [
        ("Crew mates", fmt(d["followers"]), "followers", "#E74C3C"),
        ("Treasure chests", fmt(d["repos"]), "public repositories", GOLD),
        ("Stars hoarded", fmt(d["stars"]), "stars earned", "#FFD36B"),
        ("Commits", fmt(d["commits"]), "last 12 months", "#2ECC71"),
        ("Pull requests", fmt(d["prs"]), "last 12 months", "#00C2FF"),
        ("Issues", fmt(d["issues"]), "last 12 months", "#A06CD5"),
    ]
    body = ""
    for i, (label, value, sub, color) in enumerate(cards):
        col, row = i % 3, i // 3
        body += card(col * 182, row * 108, 170, 96, label, value, sub, color, 0.08 * i)
    body += lang_panel(558, 0, 302, 204, d["langs"])
    days = [c for week in d["weeks"] for (_, c, _) in week]
    run, longest = streaks(days)
    body += streak_panels(228, run, longest, d["total"])
    return f"""<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" width="{W}" height="{H}" role="img" aria-label="GitHub bounty board: followers, repositories, stars, commits, languages and streaks">
<title>Bounty board</title>
<defs>
  <linearGradient id="card" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#14294a"/><stop offset="1" stop-color="#0a1626"/></linearGradient>
</defs>
{STATS_CSS}
{body}
</svg>"""


CAL_CSS = """<style>
.c0{fill:#14263f}.c1{fill:#6b5410}.c2{fill:#a67f12}.c3{fill:#d9a920}.c4{fill:#F5C542}
.in{animation:fadein .5s both}
.tw{animation:fadein .5s both,tw 3.4s ease-in-out infinite}
@keyframes fadein{from{opacity:0}to{opacity:1}}
@keyframes tw{0%,100%{opacity:1}50%{opacity:.55}}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style>"""


def render_contributions(d):
    placeholder = not d["weeks"]
    weeks = d["weeks"] or [[(i, 0, "") for i in range(7)] for _ in range(53)]
    W = 860
    n = len(weeks)
    step = min(15.0, (W - 64) / n)
    cell = step - 3
    gx, gy = 32, 92
    top = max((c for w in weeks for (_, c, _) in w), default=0)

    def level(c):
        if c <= 0 or top == 0:
            return 0
        return min(4, max(1, -(-c * 4 // top)))

    cells, months, last_month = "", "", None
    for ci, week in enumerate(weeks):
        for (wd, c, date) in week:
            lv = level(c)
            x, y = gx + ci * step, gy + wd * step
            if lv:
                style = f"animation-delay:{ci * 0.012:.2f}s,{0.7 + ci * 0.06:.2f}s"
                cls = f"c{lv} tw"
            else:
                style = f"animation-delay:{ci * 0.012:.2f}s"
                cls = "c0 in"
            tip = f"<title>{c} contributions{(' on ' + date) if date else ''}</title>" if date else ""
            cells += f'<rect class="{cls}" style="{style}" x="{x:.1f}" y="{y:.1f}" width="{cell:.1f}" height="{cell:.1f}" rx="3">{tip}</rect>'
        if week and week[0][2]:
            month = week[0][2][5:7]
            if month != last_month:
                names = "JanFebMarAprMayJunJulAugSepOctNovDec"
                label = names[(int(month) - 1) * 3:(int(month) - 1) * 3 + 3]
                if ci < n - 2:
                    months += f'<text x="{gx + ci * step:.1f}" y="{gy - 8}" font-family="{SANS}" font-size="10" fill="#8fa3bd">{label}</text>'
                last_month = month

    caption = ("Run the “Update profile assets” workflow once to chart your real voyage."
               if placeholder else f"{d['total']} contributions in the last year")
    legend_x = W - 32 - 5 * 16 - 70
    legend = f'<text x="{legend_x}" y="{gy + 7 * step + 22}" font-family="{SANS}" font-size="10" fill="#8fa3bd">Calm seas</text>'
    for i in range(5):
        legend += f'<rect class="c{i}" x="{legend_x + 56 + i * 16}" y="{gy + 7 * step + 13}" width="12" height="12" rx="3"/>'
    legend += f'<text x="{legend_x + 56 + 5 * 16 + 4}" y="{gy + 7 * step + 22}" font-family="{SANS}" font-size="10" fill="#8fa3bd">Storm</text>'
    H = int(gy + 7 * step + 40)

    sea = (
        wave(W, 50, 76, 3, 90, "#12507a", 5, 1, 0.9)
    )
    ship = f"""<g><animateMotion dur="30s" repeatCount="indefinite" path="M -70 52 L 930 52"/>
  <g transform="scale(.24)"><g><animateTransform attributeName="transform" type="rotate" values="-3;3;-3" dur="4s" repeatCount="indefinite"/>{SHIP}</g></g></g>"""
    front = wave(W, 56, 76, 4, 120, "#0B3C5D", 6, -1)

    return f"""<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" width="{W}" height="{H}" role="img" aria-label="Contribution calendar with a pirate ship sailing above it">
<title>Sea chart</title>
<defs>
  <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0d2038"/><stop offset="1" stop-color="#1c3d63"/></linearGradient>
  <clipPath id="strip"><rect x="0" y="0" width="{W}" height="76" rx="14"/></clipPath>
</defs>
{CAL_CSS}
<rect width="{W}" height="{H}" rx="16" fill="#0a1626"/>
<g clip-path="url(#strip)">
  <rect width="{W}" height="76" fill="url(#sky)"/>
  <circle cx="780" cy="28" r="9" fill="#FFE9A0" opacity=".9"><animate attributeName="opacity" values=".9;.55;.9" dur="5s" repeatCount="indefinite"/></circle>
  {sea}
  {ship}
  {front}
</g>
{months}
{cells}
<text x="{gx}" y="{gy + 7 * step + 22}" font-family="{SERIF}" font-style="italic" font-size="13" fill="#c8d4e6">{html.escape(caption)}</text>
{legend}
</svg>"""


def write(name, content):
    os.makedirs(OUT, exist_ok=True)
    with open(os.path.join(OUT, name), "w", encoding="utf-8") as fh:
        fh.write(content)
    print("wrote", name)


def main():
    data = fetch()
    if not data["ok"]:
        print("GitHub API unavailable; keeping the existing images.")
        sys.exit(1)
    write("stats.svg", render_stats(data))
    if data["weeks"]:
        write("contributions.svg", render_contributions(data))
    else:
        print("No contribution calendar returned; keeping the existing contributions.svg.")


if __name__ == "__main__":
    main()
